generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Partner {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  partnerId Int    @unique @map("id")
  name      String
  users     User[]

  @@map("partners")
}

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userRecordId   Int       @unique @map("id")
  externalUserId Int       @map("user_id")
  username       String    @map("user")
  partnerId      Int       @map("partner_id")
  partner        Partner   @relation(fields: [partnerId], references: [partnerId])
  sessions       Session[]

  @@unique([externalUserId, partnerId])
  @@map("users")
}

model Session {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  sessionId   Int          @unique @map("session_id")
  userId      Int          @map("user_id")
  startTime   DateTime     @map("start_time")
  endTime     DateTime?    @map("end_time")
  result      Int?
  status      SessionStatus?
  firstGame   GameType?    @map("first_game")
  secondGame  GameType?    @map("second_game")
  currentGame GameType?    @map("current_game")
  currentStep Int?         @map("current_step")
  user        User         @relation(fields: [userId], references: [userRecordId])
  gameResults GameResult[]

  @@map("sessions")
}

model GameResult {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId Int      @map("session_id")
  session   Session  @relation(fields: [sessionId], references: [sessionId])
  gameType  GameType
  stepIndex Int?     @map("step_index")
  metrics   Json
  passed    Boolean
  createdAt DateTime @default(now())

  @@map("game_results")
}

enum SessionStatus {
  ACTIVE
  PASSED
  FAILED
}

enum GameType {
  OCULAR
  TIMER
  MAZE
  REVERSE_TYPE
  MEMORY
  REFLEX
  SWIPE
  STROOP
}
